<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DanmakuFactoryBindingTest</AssemblyName>
    <RootNamespace>DanmakuFactory</RootNamespace>
    <!-- TestBinding 与 Example 均含 Main，以 TestBinding 为测试入口 -->
    <StartupObject>TestBinding</StartupObject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- 定位 xmake 构建的原生 DanmakuFactory.dll（优先 release，其次 debug），
       复制到输出目录供 DllImport 加载 -->
  <PropertyGroup>
    <DfRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))</DfRepoRoot>
    <DfDllRelease>$(DfRepoRoot)\build\windows\x64\release\DanmakuFactory.dll</DfDllRelease>
    <DfDllDebug>$(DfRepoRoot)\build\windows\x64\debug\DanmakuFactory.dll</DfDllDebug>
    <DfNativeDll Condition="Exists('$(DfDllRelease)')">$(DfDllRelease)</DfNativeDll>
    <DfNativeDll Condition="'$(DfNativeDll)'=='' AND Exists('$(DfDllDebug)')">$(DfDllDebug)</DfNativeDll>
  </PropertyGroup>

  <ItemGroup Condition="'$(DfNativeDll)'!=''">
    <None Include="$(DfNativeDll)" Link="DanmakuFactory.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CheckNativeDll" BeforeTargets="Build" Condition="'$(DfNativeDll)'==''">
    <Warning Text="DanmakuFactory.dll not found under build\windows\x64. Run `xmake build lib-shared` first." />
  </Target>

</Project>
